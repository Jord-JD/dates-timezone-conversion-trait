{
  "name": "jord-jd/dates-timezone-conversion-trait",
  "description": "Automatically convert an Eloquent model's dates to and from the current user's timezone",
  "type": "library",
  "require": {
    "php": ">=5.5.9",
    "illuminate/database": "^5.1 || ^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/support": "^5.1 || ^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
  },
  "license": "LGPL-3.0-only",
  "authors": [
    {
      "name": "Jordan Hall",
      "email": "jordan@hall05.co.uk"
    }
  ],
  "autoload": {
    "psr-4": {
      "JordJD\\DatesTimezoneConversion\\": "src/"
    }
  },
  "replace": {
    "divineomega/dates-timezone-conversion-trait": "self.version"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "3.0-dev"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^4.8 || ^9.6 || ^12.0"
  }
}
